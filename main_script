def keep_largest_component(mask: np.ndarray, min_pixels: int) -> np.ndarray:
    binary = (mask > 0).astype(np.uint8)
    count, labels, stats, _ = cv2.connectedComponentsWithStats(binary, connectivity=8)
    if count <= 1:
        return binary
    candidates = [
        i for i in range(1, count)
        if stats[i, cv2.CC_STAT_AREA] >= min_pixels
    ]
    if not candidates:
        return np.zeros_like(binary)
    largest = max(candidates, key=lambda i: stats[i, cv2.CC_STAT_AREA])
    return (labels == largest).astype(np.uint8)

def skeleton_endpoints(binary_mask: np.ndarray) -> list[tuple[int, int]]:
    skel = skeletonize(binary_mask > 0).astype(np.uint8)
    if skel.sum() == 0:
        return []
    neighbor_count = cv2.filter2D(
        skel, -1, np.ones((3, 3), dtype=np.uint8),
        borderType=cv2.BORDER_CONSTANT
    )
    # Count includes the center pixel, so endpoint total is 2.
    ys, xs = np.where((skel == 1) & (neighbor_count == 2))
    return [(int(x), int(y)) for x, y in zip(xs, ys)]

def choose_tip(
    endpoints: list[tuple[int, int]],
    previous_tip: Optional[np.ndarray],
) -> Optional[np.ndarray]:
    if not endpoints:
        return previous_tip
    points = np.asarray(endpoints, dtype=np.float32)
    if previous_tip is None:
        # POC convention: distal tip is often the higher endpoint.
        # Change this rule if Guide3D metadata identifies insertion direction.
        return points[np.argmin(points[:, 1])]
    distances = np.linalg.norm(points - previous_tip[None], axis=1)
    return points[np.argmin(distances)]

def smooth_tip(
    current: Optional[np.ndarray],
    previous: Optional[np.ndarray],
    alpha: float,
) -> Optional[np.ndarray]:
    if current is None:
        return previous
    if previous is None:
        return current
    return (1 - alpha) * previous + alpha * current


