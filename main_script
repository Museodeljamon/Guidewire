        print("Copying Guide3D from Drive to the Colab SSD for faster training...")
        shutil.rmtree(local_root, ignore_errors=True)
        local_root.mkdir(parents=True, exist_ok=True)
        run_command([
            "rsync", "--archive", "--human-readable", "--info=progress2",
            f"{drive_root}/", f"{local_root}/",
        ])

    if not (local_root / example_image).exists():
        raise RuntimeError("The local Colab SSD copy failed verification.")

    return local_root

