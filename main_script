def open_video_writer(
    output_path: Path,
    width: int,
    height: int,
) -> cv2.VideoWriter:
    output_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    writer = cv2.VideoWriter(
        str(output_path),
        cv2.VideoWriter_fourcc(*"mp4v"),
        float(CFG.overlay_fps),
        (
            int(width),
            int(height),
        ),
    )

    if not writer.isOpened():
        raise RuntimeError(
            f"Could not open video writer: {output_path}"
        )

    return writer


def add_video_label(
    frame: np.ndarray,
    label: str,
) -> np.ndarray:
    output = frame.copy()

    font = cv2.FONT_HERSHEY_SIMPLEX
    font_scale = 0.52
    thickness = 1
    x = 12
    y = 27

    (text_width, text_height), baseline = cv2.getTextSize(
        label,
        font,
        font_scale,
        thickness,
    )

    cv2.rectangle(
        output,
        (
            x - 6,
            y - text_height - 7,
        ),
        (
            x + text_width + 7,
            y + baseline + 5,
        ),
        (0, 0, 0),
        -1,
    )

    cv2.putText(
        output,
        label,
        (x, y),
        font,
        font_scale,
        (255, 255, 255),
        thickness,
        cv2.LINE_AA,
    )

    return output


def make_tracking_overlay(
    original_bgr: np.ndarray,
    binary_mask: np.ndarray,
    tip: Optional[np.ndarray],
    trail: list[tuple[int, int]],
) -> np.ndarray:
    overlay = original_bgr.copy()
    foreground = binary_mask > 0

    if foreground.any():
        green_layer = np.zeros_like(
            overlay
        )
        green_layer[:, :, 1] = 255

        overlay[foreground] = (
            0.35 * overlay[foreground]
            + 0.65 * green_layer[foreground]
        ).astype(np.uint8)

    if tip is not None:
        point = tuple(
            np.round(tip)
            .astype(int)
            .tolist()
        )

        trail.append(point)
        del trail[:-30]

        for first, second in zip(
            trail[:-1],
            trail[1:],
        ):
            cv2.line(
                overlay,
                first,
                second,
                (255, 100, 0),
                2,
                cv2.LINE_AA,
            )

        cv2.circle(
            overlay,
            point,
            6,
            (0, 0, 255),
            -1,
            cv2.LINE_AA,
        )

        cv2.circle(
            overlay,
            point,
            9,
            (255, 255, 255),
            1,
            cv2.LINE_AA,
        )

    return overlay


@torch.no_grad()
def export_sequence_demo(
    sequence: SequenceRecord,
    output_root: Path,
    max_frames: Optional[int] = None,
) -> dict:
    model.eval()

    rows = list(
        sequence.rows
    )

    if max_frames is not None:
        rows = rows[
            :max_frames
        ]

    if len(rows) < CFG.window_size:
        raise ValueError(
            f"{sequence.sequence_id} is shorter "
            "than the temporal window."
        )

    sequence_name = safe_video_name(
        sequence.sequence_id
    )

    sequence_output = (
        output_root
        / sequence_name
    )

    sequence_output.mkdir(
        parents=True,
        exist_ok=True,
    )

    original_path = (
        sequence_output
        / f"{sequence_name}_original.mp4"
    )

    overlay_path = (
        sequence_output
        / f"{sequence_name}_ai_overlay.mp4"
    )

    comparison_path = (
        sequence_output
        / f"{sequence_name}_comparison.mp4"
    )

    original_writer = open_video_writer(
        original_path,
        CFG.image_size,
        CFG.image_size,
    )

    overlay_writer = open_video_writer(
        overlay_path,
        CFG.image_size,
        CFG.image_size,
    )

    comparison_writer = open_video_writer(
        comparison_path,
        CFG.image_size * 2,
        CFG.image_size,
    )

    previous_tip = None
    trail: list[tuple[int, int]] = []
    exported_frames = 0

    try:
        for end in range(
            CFG.window_size - 1,
            len(rows),
        ):
            window_rows = rows[
                end - CFG.window_size + 1:
                end + 1
            ]

            raw_frames = [
                resize_square(
                    read_grayscale(
                        row.image_path
                    ),
                    CFG.image_size,
                    False,
                )
                for row in window_rows
            ]

            tensor = torch.stack(
                [
                    torch.from_numpy(
                        np.stack(
                            [frame] * 3,
                            axis=0,
                        )
                    ).float()
                    for frame in raw_frames
                ],
                dim=0,
            )[None].to(
                DEVICE,
                non_blocking=True,
            )

            logits = model(
                tensor
            )

            probability = (
                torch.sigmoid(
                    logits
                )[0, 0]
                .float()
                .cpu()
                .numpy()
            )

            binary = keep_largest_component(
                probability >= CFG.threshold,
                CFG.min_component_pixels,
            )

            endpoints = skeleton_endpoints(
                binary
            )

            raw_tip = choose_tip(
                endpoints,
                previous_tip,
            )

            tip = smooth_tip(
                raw_tip,
                previous_tip,
                CFG.tip_smoothing_alpha,
            )

            previous_tip = tip

            gray = (
                np.clip(
                    raw_frames[-1],
                    0.0,
                    1.0,
                )
                * 255.0
            ).astype(np.uint8)

            original = cv2.cvtColor(
                gray,
                cv2.COLOR_GRAY2BGR,
            )

            overlay = make_tracking_overlay(
                original_bgr=original,
                binary_mask=binary,
                tip=tip,
                trail=trail,
            )

            frame_text = (
                f"{sequence.sequence_id} | "
                f"frame {window_rows[-1].frame_index}"
            )

            cv2.putText(
                overlay,
                frame_text,
                (
                    10,
                    CFG.image_size - 12,
                ),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.42,
                (255, 255, 255),
                1,
                cv2.LINE_AA,
            )

            original_labeled = add_video_label(
                original,
                ORIGINAL_LABEL,
            )

            overlay_labeled = add_video_label(
                overlay,
                OUTPUT_LABEL,
            )

            comparison = np.hstack(
                [
                    original_labeled,
                    overlay_labeled,
                ]
            )

            original_writer.write(
                original_labeled
            )

            overlay_writer.write(
                overlay_labeled
            )

            comparison_writer.write(
                comparison
            )

            exported_frames += 1

    finally:
        original_writer.release()
        overlay_writer.release()
        comparison_writer.release()

    result = {
        "sequence_id": str(
            sequence.sequence_id
        ),
        "frames_exported": int(
            exported_frames
        ),
        "fps": float(
            CFG.overlay_fps
        ),
        "duration_seconds": (
            float(exported_frames)
            / max(
                float(CFG.overlay_fps),
                1e-6,
            )
        ),
        "original_video": str(
            original_path
        ),
        "ai_overlay_video": str(
            overlay_path
        ),
        "comparison_video": str(
            comparison_path
        ),
    }

    (
        sequence_output
        / f"{sequence_name}_metadata.json"
    ).write_text(
        json.dumps(
            result,
            indent=2,
        ),
        encoding="utf-8",
    )

    print(
        f"Exported {sequence.sequence_id}: "
        f"{exported_frames} frames"
    )
    print(
        "  Original  :",
        original_path,
    )
    print(
        "  AI output :",
        overlay_path,
    )
    print(
        "  Comparison:",
        comparison_path,
    )

    return result


def create_comparison_montage(
    comparison_paths: list[Path],
    output_path: Path,
    gap_frames: int = 8,
) -> None:
    width = CFG.image_size * 2
    height = CFG.image_size

    writer = open_video_writer(
        output_path,
        width,
        height,
    )

    gap = np.zeros(
        (
            height,
            width,
            3,
        ),
        dtype=np.uint8,
    )

    try:
        for clip_index, clip_path in enumerate(
            comparison_paths
        ):
            capture = cv2.VideoCapture(
                str(clip_path)
            )

            if not capture.isOpened():
                print(
                    "Could not open montage clip:",
                    clip_path,
                )
                continue

            while True:
                success, frame = capture.read()

                if not success:
                    break

                if frame.shape[:2] != (
                    height,
                    width,
                ):
                    frame = cv2.resize(
                        frame,
                        (
                            width,
                            height,
                        ),
                        interpolation=cv2.INTER_LINEAR,
                    )

                writer.write(
                    frame
                )

            capture.release()

            if clip_index < len(comparison_paths) - 1:
                for _ in range(gap_frames):
                    writer.write(
                        gap
                    )

    finally:
        writer.release()


