@dataclass(frozen=True)
class FrameRecord:
    sequence_id: str
    frame_index: int
    image_path: Path
    points: np.ndarray

@dataclass(frozen=True)
class SequenceRecord:
    sequence_id: str
    rows: tuple[FrameRecord, ...]


def safe_sequence_name(value: str) -> str:
    value = str(value).strip()
    value = re.sub(r"[^A-Za-z0-9_.-]+", "_", value)
    return value or "unknown_sequence"


def natural_key_string(value: str):
    return [
        int(token) if token.isdigit() else token.lower()
        for token in re.split(r"(\d+)", value)
    ]


def build_official_sequences(raw_data) -> list[SequenceRecord]:
    sequences: list[SequenceRecord] = []

    for pair_index, video_pair in enumerate(raw_data):
        frames = video_pair.get("frames", [])
        for camera_key in ("camera1", "camera2"):
            camera_rows: list[FrameRecord] = []
            for frame_index, frame in enumerate(frames):
                camera = frame.get(camera_key, {})
                relative_path = camera.get("image")
                points = camera.get("points")
                if relative_path is None or points is None:
                    continue

                image_path = DATASET_ROOT / relative_path
                if not image_path.exists():
                    raise FileNotFoundError(
                        f"Annotated image does not exist: {image_path}"
                    )

                pts = np.asarray(points, dtype=np.int32).reshape(-1, 2)
                sequence_id = safe_sequence_name(
                    f"pair_{pair_index:03d}_{camera_key}"
                )
                camera_rows.append(
                    FrameRecord(
                        sequence_id=sequence_id,
                        frame_index=frame_index,
                        image_path=image_path,
                        points=pts,
                    )
                )

            if len(camera_rows) >= CFG.window_size:
                sequences.append(
                    SequenceRecord(
                        sequence_id=camera_rows[0].sequence_id,
                        rows=tuple(camera_rows),
                    )
                )

    sequences.sort(key=lambda item: natural_key_string(item.sequence_id))
    return sequences


