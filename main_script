def read_grayscale(path: Path) -> np.ndarray:
    array = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)
    if array is None:
        raise ValueError(f"Cannot read image: {path}")
    array = array.astype(np.float32)
    lo, hi = np.percentile(array, (1, 99))
    if hi <= lo:
        lo, hi = float(array.min()), float(array.max())
    return np.clip((array - lo) / max(hi - lo, 1e-6), 0, 1)


def make_guidewire_mask(points: np.ndarray, source_shape: tuple[int, int]) -> np.ndarray:
    mask = np.zeros(source_shape, dtype=np.uint8)
    if len(points) >= 2:
        cv2.polylines(
            mask,
            [points.reshape(-1, 1, 2)],
            isClosed=False,
            color=1,
            thickness=2,
            lineType=cv2.LINE_8,
        )
    elif len(points) == 1:
        cv2.circle(mask, tuple(points[0]), 1, 1, -1)
    return mask.astype(np.float32)


def resize_square(array: np.ndarray, size: int, is_mask: bool) -> np.ndarray:
    interpolation = cv2.INTER_NEAREST if is_mask else cv2.INTER_LINEAR
    return cv2.resize(array, (size, size), interpolation=interpolation)


def augment_sequence(frames: list[np.ndarray], mask: np.ndarray):
    if random.random() < 0.5:
        frames = [np.fliplr(x).copy() for x in frames]
        mask = np.fliplr(mask).copy()

    angle = random.uniform(-4.0, 4.0)
    scale = random.uniform(0.97, 1.03)
    center = (CFG.image_size / 2, CFG.image_size / 2)
    matrix = cv2.getRotationMatrix2D(center, angle, scale)
    frames = [
        cv2.warpAffine(
            x, matrix, (CFG.image_size, CFG.image_size),
            flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REFLECT
        )
        for x in frames
    ]
    mask = cv2.warpAffine(
        mask, matrix, (CFG.image_size, CFG.image_size),
        flags=cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT
    )

    gamma = random.uniform(0.85, 1.15)
    noise_std = random.uniform(0.0, 0.015)
    frames = [
        np.clip(x ** gamma + np.random.normal(0, noise_std, x.shape), 0, 1)
        .astype(np.float32)
        for x in frames
    ]
    return frames, mask


@dataclass(frozen=True)
class WindowRecord:
    sequence_id: str
    rows: tuple[FrameRecord, ...]


def make_windows(records: Iterable[SequenceRecord]) -> list[WindowRecord]:
    windows: list[WindowRecord] = []
    for rec in records:
        sequence_windows: list[WindowRecord] = []
        stop = len(rec.rows) - CFG.window_size + 1
        for start in range(0, stop, CFG.temporal_stride):
            rows = rec.rows[start:start + CFG.window_size]
            sequence_windows.append(
                WindowRecord(sequence_id=rec.sequence_id, rows=rows)
            )
        if CFG.max_windows_per_sequence:
            sequence_windows = sequence_windows[: CFG.max_windows_per_sequence]
        windows.extend(sequence_windows)
    return windows


class GuidewireWindowDataset(Dataset):
    def __init__(self, records: list[SequenceRecord], training: bool):
        self.windows = make_windows(records)
        self.training = training
        if not self.windows:
            raise RuntimeError("This split generated zero temporal windows.")

    def __len__(self):
        return len(self.windows)

    def __getitem__(self, index: int):
        item = self.windows[index]
        original_frames = [read_grayscale(row.image_path) for row in item.rows]
        source_shape = original_frames[-1].shape
        mask = make_guidewire_mask(item.rows[-1].points, source_shape)

        frames = [
            resize_square(frame, CFG.image_size, is_mask=False)
            for frame in original_frames
        ]
        mask = resize_square(mask, CFG.image_size, is_mask=True)

        if self.training:
            frames, mask = augment_sequence(frames, mask)

        frames_rgb = [
            torch.from_numpy(np.stack([frame] * 3, axis=0)).float()
            for frame in frames
        ]
        x = torch.stack(frames_rgb, dim=0)
        y = torch.from_numpy(mask[None]).float()

        return {
            "frames": x,
            "mask": y,
            "sequence_id": item.sequence_id,
            "last_frame_index": item.rows[-1].frame_index,
        }


