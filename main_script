def split_sequences(records: list[SequenceRecord], seed: int):
    records = records.copy()
    rng = random.Random(seed)
    rng.shuffle(records)

    n = len(records)
    n_train = max(1, int(n * CFG.train_fraction))
    n_val = max(1, int(n * CFG.val_fraction)) if n >= 3 else 0

    train = records[:n_train]
    val = records[n_train:n_train + n_val]
    test = records[n_train + n_val:]

    if not val:
        val = train[-1:]
        train = train[:-1] or train
    if not test:
        test = val[-1:]

    return train, val, test


