class ConvLSTMCell(nn.Module):
    def __init__(self, input_channels: int, hidden_channels: int, kernel_size: int = 3):
        super().__init__()
        padding = kernel_size // 2
        self.hidden_channels = hidden_channels
        self.gates = nn.Conv2d(
            input_channels + hidden_channels,
            4 * hidden_channels,
            kernel_size=kernel_size,
            padding=padding,
        )

    def forward(self, x, state):
        h, c = state
        gates = self.gates(torch.cat([x, h], dim=1))
        i, f, o, g = torch.chunk(gates, 4, dim=1)
        i = torch.sigmoid(i)
        f = torch.sigmoid(f)
        o = torch.sigmoid(o)
        g = torch.tanh(g)
        c = f * c + i * g
        h = o * torch.tanh(c)
        return h, c

class ConvLSTM(nn.Module):
    def __init__(self, input_channels: int, hidden_channels: int):
        super().__init__()
        self.cell = ConvLSTMCell(input_channels, hidden_channels)

    def forward(self, x):
        # x: B,T,C,H,W
        b, t, _, h, w = x.shape
        hidden = torch.zeros(
            b, self.cell.hidden_channels, h, w, device=x.device, dtype=x.dtype
        )
        cell = torch.zeros_like(hidden)
        outputs = []
        for step in range(t):
            hidden, cell = self.cell(x[:, step], (hidden, cell))
            outputs.append(hidden)
        return torch.stack(outputs, dim=1), (hidden, cell)

class ConvBlock(nn.Module):
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        groups = min(8, out_ch)
        while out_ch % groups != 0:
            groups -= 1
        self.block = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, 3, padding=1, bias=False),
            nn.GroupNorm(groups, out_ch),
            nn.GELU(),
            nn.Conv2d(out_ch, out_ch, 3, padding=1, bias=False),
            nn.GroupNorm(groups, out_ch),
            nn.GELU(),
        )

    def forward(self, x):
        return self.block(x)

class LightweightDecoder(nn.Module):
    def __init__(self, in_channels: int, channels: tuple[int, ...], output_size: int):
        super().__init__()
        blocks = []
        current = in_channels
        for out_ch in channels:
            blocks.append(ConvBlock(current, out_ch))
            current = out_ch
        self.blocks = nn.ModuleList(blocks)
        self.output_head = nn.Conv2d(current, 1, kernel_size=1)
        self.output_size = output_size

    def forward(self, x):
        for block in self.blocks:
            x = block(x)
            next_h = min(x.shape[-2] * 2, self.output_size)
            next_w = min(x.shape[-1] * 2, self.output_size)
            if (next_h, next_w) != x.shape[-2:]:
                x = F.interpolate(
                    x, size=(next_h, next_w),
                    mode="bilinear", align_corners=False
                )
        x = self.output_head(x)
        if x.shape[-2:] != (self.output_size, self.output_size):
            x = F.interpolate(
                x, size=(self.output_size, self.output_size),
                mode="bilinear", align_corners=False
            )
        return x

class FluoroSAMConvLSTM(nn.Module):
    def __init__(self, checkpoint: str):
        super().__init__()
        ckpt = Path(checkpoint)
        if not ckpt.exists():
            raise FileNotFoundError(
                f"FluoroSAM checkpoint not found: {ckpt}\n"
                "Download the official 2.5 GB checkpoint from the FluoroSAM README "
                "and update CFG.fluorosam_checkpoint."
            )

        self.sam = create_sam_model(
            backbone=CFG.fluorosam_backbone,
            pretrained=True,
            weight_path=str(ckpt),
        )
        self.encoder = self.sam.image_encoder

        # Official FluoroSAM SAM neck emits 256-channel image embeddings.
        self.temporal = ConvLSTM(256, CFG.convlstm_hidden)
        self.decoder = LightweightDecoder(
            CFG.convlstm_hidden, CFG.decoder_channels, CFG.image_size
        )

        self.set_encoder_trainable(not CFG.freeze_encoder)

    def set_encoder_trainable(self, trainable: bool):
        for parameter in self.encoder.parameters():
            parameter.requires_grad = trainable
        if trainable:
            self.encoder.train()
        else:
            self.encoder.eval()

    def encode(self, frames):
        # frames: B,T,3,H,W, values in [0,1]
        b, t, c, h, w = frames.shape
        flat = frames.reshape(b * t, c, h, w)

        # FluoroSAM normalization: (x - 0.5) / 0.5.
        mean = self.sam.pixel_mean.to(flat.device)
        std = self.sam.pixel_std.to(flat.device)
        flat = (flat - mean) / std

        encoder_frozen = not any(
            parameter.requires_grad for parameter in self.encoder.parameters()
        )
        chunks = []
        chunk_size = max(1, int(CFG.encoder_chunk_size))

        for start in range(0, flat.shape[0], chunk_size):
            chunk = flat[start:start + chunk_size]
            if encoder_frozen:
                with torch.no_grad():
                    encoded = self.encoder(chunk)
            else:
                encoded = self.encoder(chunk)

            if isinstance(encoded, dict):
                encoded = encoded.get(
                    "stage_final", next(iter(encoded.values()))
                )
            chunks.append(encoded)

        features = torch.cat(chunks, dim=0)
        _, channels, fh, fw = features.shape
        return features.reshape(b, t, channels, fh, fw)

    def forward(self, frames):
        features = self.encode(frames)
        _, (last_hidden, _) = self.temporal(features)
        logits = self.decoder(last_hidden)
        return logits

