def resolve_fluorosam_checkpoint() -> Path:
    """
    Reuse a valid Drive checkpoint when present. Otherwise download the
    official FluoroSAM weight file to Colab first, validate it, then move it
    into Google Drive so later sessions do not download it again.
    """
    configured = Path(CFG.fluorosam_checkpoint)
    configured.parent.mkdir(parents=True, exist_ok=True)

    def looks_valid(path: Path) -> bool:
        return (
            path.exists()
            and path.is_file()
            and path.stat().st_size >= CFG.fluorosam_checkpoint_min_bytes
        )

    if CFG.force_redownload_checkpoint and configured.exists():
        print("Forced FluoroSAM checkpoint refresh requested.")
        configured.unlink()

    if looks_valid(configured):
        print(
            "Using cached FluoroSAM checkpoint:",
            configured,
            f"({configured.stat().st_size / 1024**3:.2f} GB)",
        )
        return configured

    # Search for a previously uploaded checkpoint with another filename.
    search_root = configured.parent
    candidates = []
    for pattern in ("*.pth", "*.pt", "*.ckpt"):
        candidates.extend(search_root.rglob(pattern))

    candidates = [path for path in candidates if looks_valid(path)]
    candidates.sort(key=lambda path: path.stat().st_size, reverse=True)

    if candidates:
        selected = candidates[0]
        print(
            "Using existing FluoroSAM checkpoint:",
            selected,
            f"({selected.stat().st_size / 1024**3:.2f} GB)",
        )
        CFG.fluorosam_checkpoint = str(selected)
        return selected

    print("No valid FluoroSAM checkpoint was found in Drive.")
    print("Downloading the official checkpoint linked by the FluoroSAM authors...")

    temp_checkpoint = Path("/content/fluorosam_checkpoint_download.tmp")
    temp_checkpoint.unlink(missing_ok=True)

    result = gdown.download(
        id=CFG.fluorosam_checkpoint_gdrive_id,
        output=str(temp_checkpoint),
        quiet=False,
        fuzzy=True,
    )
    if result is None or not temp_checkpoint.exists():
        raise RuntimeError(
            "The official FluoroSAM checkpoint download failed. "
            "Google Drive may have temporarily blocked large-file downloads."
        )

    downloaded_bytes = temp_checkpoint.stat().st_size
    if downloaded_bytes < CFG.fluorosam_checkpoint_min_bytes:
        temp_checkpoint.unlink(missing_ok=True)
        raise RuntimeError(
            "The downloaded FluoroSAM checkpoint is unexpectedly small: "
            f"{downloaded_bytes / 1024**2:.1f} MB. "
            "The download likely returned an error page or incomplete file."
        )

    print(
        "Checkpoint download completed:",
        f"{downloaded_bytes / 1024**3:.2f} GB",
    )
    print("Checking that PyTorch can read the checkpoint...")

    try:
        checkpoint_preview = torch.load(
            temp_checkpoint,
            map_location="cpu",
            weights_only=False,
        )
    except Exception as exc:
        temp_checkpoint.unlink(missing_ok=True)
        raise RuntimeError(
            "The downloaded file is not a readable PyTorch checkpoint."
        ) from exc

    if not isinstance(checkpoint_preview, dict):
        temp_checkpoint.unlink(missing_ok=True)
        raise RuntimeError(
            "The official checkpoint loaded, but its top-level object is not "
            "a state-dictionary-like mapping."
        )

    del checkpoint_preview
    gc.collect()

    print("Checkpoint verified. Copying it permanently to Google Drive...")
    drive_staging = configured.with_suffix(configured.suffix + ".staging")
    drive_staging.unlink(missing_ok=True)

    shutil.copy2(temp_checkpoint, drive_staging)

    if not looks_valid(drive_staging):
        drive_staging.unlink(missing_ok=True)
        raise RuntimeError("The checkpoint copy to Google Drive failed verification.")

    drive_staging.replace(configured)
    temp_checkpoint.unlink(missing_ok=True)

    manifest = {
        "model": "FluoroSAM",
        "source": "Official FluoroSAM repository README Google Drive link",
        "official_google_drive_file_id": CFG.fluorosam_checkpoint_gdrive_id,
        "saved_path": str(configured),
        "bytes": configured.stat().st_size,
    }
    configured.with_suffix(configured.suffix + ".source.json").write_text(
        json.dumps(manifest, indent=2),
        encoding="utf-8",
    )

    print(
        "Permanent FluoroSAM checkpoint saved:",
        configured,
        f"({configured.stat().st_size / 1024**3:.2f} GB)",
    )
    return configured

