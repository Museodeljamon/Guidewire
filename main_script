def first_annotated_image_path(raw_data) -> Path:
    for video_pair in raw_data:
        for frame in video_pair.get("frames", []):
            for camera_key in ("camera1", "camera2"):
                camera = frame.get(camera_key, {})
                image_path = camera.get("image")
                if image_path:
                    return Path(image_path)
    raise RuntimeError("raw.json contains no image paths.")


def locate_extracted_dataset_root(extract_root: Path, relative_image: Path) -> Path:
    direct = extract_root / relative_image
    if direct.exists():
        return extract_root

    filename = relative_image.name
    for candidate in extract_root.rglob(filename):
        try:
            root = candidate
            for _ in relative_image.parts:
                root = root.parent
            if (root / relative_image).exists():
                return root
        except Exception:
            continue

    raise RuntimeError(
        "Guide3D was extracted, but its image root could not be identified.\n"
        f"Expected to find the annotated path: {relative_image}"
    )


def prepare_guide3d() -> Path:
    """
    First run:
        official Guide3D source -> Colab SSD -> extract and verify -> Google Drive

    Later runs:
        verified Google Drive copy -> optional Colab SSD copy -> training

    The archive is never extracted directly into Drive. This avoids leaving a
    partial dataset marked ready if downloading, extraction, or copying fails.
    """
    drive_root = Path(CFG.drive_dataset_root)
    local_root = Path(CFG.local_dataset_root)
    annotation_path = Path(CFG.annotations_file)

    raw_data = load_annotation_json(annotation_path)
    example_image = first_annotated_image_path(raw_data)

    ready_marker = drive_root / CFG.dataset_ready_marker
    source_manifest = drive_root / "guide3d_source_manifest.json"

    drive_copy_is_valid = (
        ready_marker.exists()
        and source_manifest.exists()
        and (drive_root / example_image).exists()
    )

    if CFG.force_redownload_dataset and drive_root.exists():
        print("Forced refresh requested. Removing the existing Drive copy...")
        shutil.rmtree(drive_root, ignore_errors=True)
        drive_copy_is_valid = False

    if not drive_copy_is_valid:
        print("No verified Guide3D copy was found in Google Drive.")
        print("Downloading from:", CFG.guide3d_source_name)
        print("Project page:", CFG.guide3d_source_page)

        temp_root = Path("/content/guide3d_official_download")
        archive_path = temp_root / "guide3d_official.zip"
        extract_root = temp_root / "extracted"

        shutil.rmtree(temp_root, ignore_errors=True)
        extract_root.mkdir(parents=True, exist_ok=True)

        # This file ID is used by the official Guide3D repository downloader.
        result = gdown.download(
            id=CFG.guide3d_gdrive_id,
            output=str(archive_path),
            quiet=False,
            fuzzy=True,
        )
        if result is None or not archive_path.exists():
            raise RuntimeError(
                "The official Guide3D archive download failed. "
                "No changes were made to the permanent Drive dataset."
            )

        archive_size = archive_path.stat().st_size
        if archive_size < 1_000_000:
            raise RuntimeError(
                f"Downloaded archive is unexpectedly small ({archive_size:,} bytes). "
                "The source may have returned an error page."
            )

        print(f"Downloaded archive: {archive_size / 1024**3:.2f} GB")
        print("Testing ZIP integrity...")
        with zipfile.ZipFile(archive_path, "r") as archive:
            corrupt_member = archive.testzip()
            if corrupt_member is not None:
                raise RuntimeError(
                    f"The official Guide3D ZIP is corrupt at: {corrupt_member}"
                )
            print("Extracting the official archive on the Colab SSD...")
            archive.extractall(extract_root)

        extracted_dataset_root = locate_extracted_dataset_root(
            extract_root, example_image
        )
        extracted_example = extracted_dataset_root / example_image
        if not extracted_example.exists():
            raise RuntimeError(
                "Extraction finished, but an image referenced by raw.json "
                f"was not found: {extracted_example}"
            )

        extracted_file_count = sum(
            1 for path in extracted_dataset_root.rglob("*") if path.is_file()
        )
        if extracted_file_count == 0:
            raise RuntimeError("The extracted Guide3D directory contains no files.")

        print("Verified extracted dataset root:", extracted_dataset_root)
        print(f"Extracted files: {extracted_file_count:,}")
        print("Copying the verified official dataset to Google Drive...")

        # Copy into a staging folder first, then rename after verification.
        drive_staging = drive_root.with_name(drive_root.name + "_staging")
        shutil.rmtree(drive_staging, ignore_errors=True)
        drive_staging.mkdir(parents=True, exist_ok=True)

        run_command([
            "rsync", "--archive", "--human-readable", "--info=progress2",
            f"{extracted_dataset_root}/", f"{drive_staging}/",
        ])

        if not (drive_staging / example_image).exists():
            raise RuntimeError(
                "The Drive staging copy failed verification for:\n"
                f"{drive_staging / example_image}"
            )

        staging_file_count = sum(
            1 for path in drive_staging.rglob("*") if path.is_file()
        )
        if staging_file_count != extracted_file_count:
            raise RuntimeError(
                "Drive copy file-count verification failed: "
                f"source={extracted_file_count:,}, drive={staging_file_count:,}."
            )

        manifest = {
            "dataset": "Guide3D",
            "source_type": CFG.guide3d_source_name,
            "project_page": CFG.guide3d_source_page,
            "official_google_drive_file_id": CFG.guide3d_gdrive_id,
            "annotation_file": str(annotation_path),
            "example_verified_image": str(example_image),
            "archive_bytes": archive_size,
            "copied_file_count": staging_file_count,
        }
        (drive_staging / "guide3d_source_manifest.json").write_text(
            json.dumps(manifest, indent=2),
            encoding="utf-8",
        )
        (drive_staging / CFG.dataset_ready_marker).write_text(
            "Official Guide3D archive downloaded, extracted, copied, and verified.\n",
            encoding="utf-8",
        )

        shutil.rmtree(drive_root, ignore_errors=True)
        drive_staging.rename(drive_root)
        shutil.rmtree(temp_root, ignore_errors=True)

        print("Permanent verified Guide3D copy saved at:", drive_root)
    else:
        print("Using the verified official Guide3D copy in Drive:", drive_root)

    if not CFG.copy_dataset_to_local_ssd:
        print("Reading demo frames directly from the Drive copy.")
